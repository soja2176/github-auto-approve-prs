# 1) Crear un OAuth App en GitHub:
#    Settings -> Developer settings -> OAuth Apps -> New OAuth App
#    Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

PORT=3000

# Postgres - coincide con docker-compose.yml. Si usás "docker compose up" no hace
# falta que toques DATABASE_URL (se arma solo apuntando al servicio "db").
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=autoapprove
DATABASE_URL=postgres://postgres:postgres@db:5432/autoapprove
